# Written from templates/python-hatchling.spec.tmpl.
# Sources: use full URLs in Source* entries — the CI submit job fetches them
# with spectool at SRPM-build time; keep downloads out of %prep (read files
# from %{_sourcedir} or %setup -a 0).
# Use an explicit Release: and a written %changelog (no rpmautospec — this
# repo matches terra's spec conventions).
# Registration: add the package to ci/packages.toml (batch + [pkg.updates]
# sweep feed) — a package without an entry is never built.
Name:           <pkg>
Version:        0.0.0
Release:        1%{?dist}
Summary:        <summary>
License:        <SPDX>
URL:            https://github.com/<owner>/<repo>
Source0:        %{url}/archive/refs/tags/%{version}/<repo>-%{version}.tar.gz
BuildRequires:  pyproject-rpm-macros python3-devel
%description
%{summary}.
%prep
%autosetup -p1
%generate_buildrequires
%pyproject_buildrequires
%build
%pyproject_wheel
%install
%pyproject_install
%pyproject_save_files -l <pkg>
%files -f %pyproject_files
%license LICENSE
%changelog
* Wed Sep 23 2026 halcyon-autoupdate <aahsnr041@proton.me> - 0.0.0-1
- initial packaging from templates/python-hatchling.spec.tmpl
