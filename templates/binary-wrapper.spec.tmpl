Name:           <pkg>
# rewritten by the daily sweep (ci/sweep) — rpm treats everything after the
# value on a tag line as part of the value, so keep comments on their own line
Version:        0.0.0
Release:        1%{?dist}
Summary:        <app> (packaged from the official upstream release)
License:        <SPDX>
URL:            https://<vendor>
Source0:        <vendor-url-with-%{version}>
Source1:        <pkg>.desktop
BuildArch:      x86_64
%description
%{summary}.
%prep
# the CI submit job fetches the Source* URLs with spectool at SRPM-build
# time; %prep only unpacks/uses what rpmbuild already downloaded. Use
# %setup -q -c -T -a 0 for archives rpmbuild can unpack; for anything else
# read it from %{_sourcedir}.
%setup -q -c -T
cp %{_sourcedir}/<artifact-file> artifact   # + vendor digest check when published
%install
mkdir -p %{buildroot}%{_libdir}/<pkg> %{buildroot}%{_bindir}
install -m0644 artifact %{buildroot}%{_libdir}/<pkg>/
ln -s %{_libdir}/<pkg>/<bin> %{buildroot}%{_bindir}/<pkg>
install -Dm0644 %{SOURCE1} %{buildroot}%{_datadir}/applications/<pkg>.desktop
%files
%{_libdir}/<pkg>/
%{_bindir}/<pkg>
%{_datadir}/applications/<pkg>.desktop
%changelog
* <date> halcyon-autoupdate - 0.0.0-1
- packaged from the upstream release
